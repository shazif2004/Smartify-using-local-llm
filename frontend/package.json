{
  "name": "smartify-local",
  "productName": "Smartify",
  "description": "A private, local AI study companion powered by Ollama.",
  "author": "Abdul",
  "private": true,
  "version": "1.2.0",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "backend:bundle": "cd ../backend && PYINSTALLER_CONFIG_DIR=build/pyinstaller-cache .venv/bin/pyinstaller --noconfirm --clean smartify-backend.spec",
    "desktop:dev": "node desktop/dev.cjs",
    "desktop:pack": "npm run build && npm run backend:bundle && electron-builder --mac dir",
    "desktop:dist": "npm run build && npm run backend:bundle && electron-builder --mac dmg",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axios": "^1.18.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "katex": "^0.18.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.smartify.local",
    "productName": "Smartify",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/smartify-backend",
        "to": "backend/smartify-backend"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Smartify",
      "artifactName": "Smartify-${version}-${arch}.${ext}"
    }
  }
}
